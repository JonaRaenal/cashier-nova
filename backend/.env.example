# ============================================
# CashierNova — Environment Variables
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================

PORT=5000

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=cashier_nova

# JWT Configuration
JWT_SECRET=cashiernova-secret-key-change-this
JWT_REFRESH_SECRET=cashiernova-refresh-secret-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Node Environment
NODE_ENV=development
